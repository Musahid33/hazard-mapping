# ============================================================================
# Hazard Map Dashboard — Environment Variables (Live + Supabase)
# Copy this file to .env and fill your values
# ============================================================================

# --- Server ---
PORT=8080
SYNC_TOKEN=
LIVE_URL=https://hazard-mapping.onrender.com
GITHUB_REPO_URL=https://github.com/Musahid33/hazard-mapping

# --- Supabase (PRIMARY for live) ---
# Get these from Supabase Dashboard → Project Settings → API Keys.
# Vercel Marketplace creates SUPABASE_URL + SUPABASE_SECRET_KEY automatically.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Preferred current server key (sb_secret_...); bypasses RLS. Keep it private.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# Legacy server key is also supported while Supabase continues to provide it.
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
# Public/RLS-restricted fallbacks (use only when server keys are unavailable).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_ANON_KEY=your_legacy_anon_key_here
# Alternative generic name (server checks all variants).
SUPABASE_KEY=your_key_here
SUPABASE_TABLE=hazard_data

# --- Optional ---
NODE_ENV=production
